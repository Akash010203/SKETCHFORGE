# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/
dist/

# Secrets (never commit credentials)
.env
.env.*
!.env.example
*.pem
*.key

# Large / generated artifacts
datasets/raw/
datasets/processed/
datasets/quarantine/
datasets/evaluation/*
!datasets/evaluation/.gitkeep
datasets/synthetic/*
!datasets/synthetic/.gitkeep
checkpoints/*
!checkpoints/.gitkeep
!checkpoints/README.md
experiments/results/*
!experiments/results/.gitkeep
!experiments/results/*.json  # small benchmark results are the evidence for documented numbers
experiments/configs/*
!experiments/configs/.gitkeep
output/*
!output/.gitkeep
!output/projects/
!output/renders/
!output/reports/
!output/logs/
output/projects/*
output/renders/*
output/reports/*
output/logs/*
!output/projects/.gitkeep
!output/renders/.gitkeep
!output/reports/.gitkeep
!output/logs/.gitkeep

# Editors / OS
.idea/
.vscode/
.DS_Store
